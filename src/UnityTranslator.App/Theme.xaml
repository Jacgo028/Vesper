<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= 设计令牌 =================
         Vesper暮星 A版：中性白昼、炭黑夜间与蓝色交互重点。
         所有颜色、字号、间距、圆角都在这里定义，页面只引用令牌，
         不在页面里写死颜色——写死颜色会在换主题时出现“一部分浅色一部分深色”的混搭。

         形状约定：统一的小圆角矩形（10 / 6px）。不使用椭圆、胶囊形标签或圆形装饰。 -->

    <!-- 背景层级：页面 < 侧栏 < 内容区 < 输入框 -->
    <Color x:Key="BgWindowColor">#FFFFFF</Color>
    <Color x:Key="BgSidebarColor">#F8F9FA</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgSubtleColor">#F8F9FA</Color>
    <Color x:Key="BgInputColor">#FFFFFF</Color>
    <Color x:Key="BgHeaderColor">#F8F9FA</Color>
    <Color x:Key="BgHoverColor">#F1F3F4</Color>
    <Color x:Key="BgSelectedColor">#E8F0FE</Color>

    <SolidColorBrush x:Key="BgWindow" Color="{DynamicResource BgWindowColor}"/>
    <SolidColorBrush x:Key="BgSidebar" Color="{DynamicResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCard" Color="{DynamicResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgSubtle" Color="{DynamicResource BgSubtleColor}"/>
    <SolidColorBrush x:Key="BgInput" Color="{DynamicResource BgInputColor}"/>
    <SolidColorBrush x:Key="BgHeader" Color="{DynamicResource BgHeaderColor}"/>
    <SolidColorBrush x:Key="BgHover" Color="{DynamicResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgSelected" Color="{DynamicResource BgSelectedColor}"/>

    <!-- 描边：用浅灰线条区分层级，不依赖阴影 -->
    <SolidColorBrush x:Key="BorderSoft" Color="#E0E3E7"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#DADCE0"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#185ABC"/>
    <SolidColorBrush x:Key="PageFocus" Color="#185ABC"/>
    <SolidColorBrush x:Key="SwitchThumbOff" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchTrackOff" Color="#68717A"/>

    <!-- 文字：主 / 次 / 弱，日夜两套表面都保持清晰对比 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#202124"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4F555B"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5F6368"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnInput" Color="#202124"/>
    <SolidColorBrush x:Key="TextOnInputSecondary" Color="#4F555B"/>
    <SolidColorBrush x:Key="TextOnInputMuted" Color="#5F6368"/>
    <SolidColorBrush x:Key="InputIcon" Color="#5F6368"/>
    <SolidColorBrush x:Key="BgPopup" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgPopupHover" Color="#F1F3F4"/>
    <SolidColorBrush x:Key="BgPopupSelected" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="LibraryActionHover" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="LibraryActionPressed" Color="#D2E3FC"/>
    <SolidColorBrush x:Key="LibraryRemoveHover" Color="#B3261E"/>
    <SolidColorBrush x:Key="LibraryRemovePressed" Color="#8C1D18"/>

    <!-- 强调色与语义色：浅色底 + 深色字，保证可读 -->
    <SolidColorBrush x:Key="Accent" Color="#0B57D0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0842A0"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#062E6F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="AccentText" Color="#185ABC"/>

    <SolidColorBrush x:Key="Success" Color="#137333"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#E6F4EA"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="#B7D9C1"/>

    <SolidColorBrush x:Key="Warning" Color="#8A4F00"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF7E0"/>
    <SolidColorBrush x:Key="WarningBorder" Color="#E8D8AB"/>

    <SolidColorBrush x:Key="Danger" Color="#B3261E"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FCE8E6"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#E7BFBB"/>
    <SolidColorBrush x:Key="OverlayScrim" Color="#66202124"/>

    <!-- 字号阶梯 -->
    <sys:Double x:Key="FontDisplay">24</sys:Double>
    <sys:Double x:Key="FontTitle">15</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontTiny">11</sys:Double>
    <sys:Double x:Key="ButtonHoverOpacity">1</sys:Double>
    <sys:Double x:Key="ButtonPressedOpacity">1</sys:Double>

    <!-- 间距阶梯 -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="TightPadding">10</Thickness>
    <Thickness x:Key="PageMargin">20,20,20,24</Thickness>

    <!-- 圆角：只用小圆角矩形 -->
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>

    <!-- ================= 基础文字样式 ================= -->

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource TextBase}"/>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="{StaticResource FontTiny}"/>
    </Style>

    <!-- 步骤编号：纯文字序号，不用圆形徽标 -->
    <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 技术原文展示：小号等宽，弱化 -->
    <Style x:Key="TechnicalText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
        <Setter Property="FontSize" Value="{StaticResource FontTiny}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ================= 卡片与提示块 ================= -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 提示块：小圆角矩形，靠左侧竖线区分语义，不使用胶囊形 -->
    <Style x:Key="NoticeBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- A版数值页沿用原来的操作流程，只将分组呈现为平面章节。 -->
    <Style x:Key="NumbersSection" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0,16,0,18"/>
    </Style>

    <Style x:Key="NoticeAccentBar" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- ================= 按钮 ================= -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="{DynamicResource ButtonHoverOpacity}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="{DynamicResource ButtonPressedOpacity}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 禁用态：浅灰底 + 灰字，一眼可辨且仍然读得清 -->
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgWindow}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Background.Color.A, RelativeSource={RelativeSource Self}}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPressed}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BgSelected}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BgSelected}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryRemoveHover}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryRemovePressed}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

    <!-- Library-only feedback: keep the native Button input/command semantics and
         existing typography/padding, while drawing opaque fill and an inset outline. -->
    <ControlTemplate x:Key="LibraryInteractionTemplate" TargetType="Button">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="InteractionOutline" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InteractionOutline" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InteractionOutline" Property="Visibility" Value="Visible"/>
                <Setter TargetName="InteractionOutline" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgWindow}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter TargetName="InteractionOutline" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="LibrarySecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Template" Value="{StaticResource LibraryInteractionTemplate}"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryActionHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryActionPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PageFocus}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LibraryPrimaryButton" TargetType="Button" BasedOn="{StaticResource LibrarySecondaryButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LibraryGhostButton" TargetType="Button" BasedOn="{StaticResource LibrarySecondaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="LibraryRemoveButton" TargetType="Button" BasedOn="{StaticResource LibrarySecondaryButton}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryRemoveHover}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LibraryRemovePressed}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 输入控件 ================= -->

    <Style x:Key="InputBase" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="CaretBrush" Value="{DynamicResource TextOnInput}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <!-- TextBox already applies Padding to its text view. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgWindow}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="CaretBrush" Value="{DynamicResource TextOnInput}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox 整套自绘：系统默认模板的配色由系统主题决定，会在自绘界面上造成浅深混搭 -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnInput}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPopupHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPopupSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Margin="10,0,6,0"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextOnInputSecondary}"
                                                  StrokeThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="11,0,30,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgPopup}" BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,3,0,0"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,3">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ================= 导航 ================= -->

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- 选中态：暖色底与深色标记，保留清晰的导航层级。 -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="9,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"
                            BorderThickness="1" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Marker" Grid.Column="0" Width="3" CornerRadius="1"
                                    Background="Transparent" Margin="0,0,8,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelected}"/>
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Disclosure" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                      FontFamily="{TemplateBinding FontFamily}" HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="1,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Data="M 3,2 L 7,6 L 3,10" Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 1,4 L 5,8 L 9,4"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource PageFocus}"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard scroll controls retain native commands and track/thumb behavior, with themed surfaces. -->
    <Style TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextMuted}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentText}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollArrowButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="ArrowSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource BgSelected}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScrollTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
            <RepeatButton Command="ScrollBar.LineUpCommand" Style="{StaticResource ScrollArrowButton}"><Path Data="M 0,4 L 4,0 L 8,4" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/></RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinHeight="24"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource ScrollArrowButton}"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/></RepeatButton>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScrollTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
            <RepeatButton Command="ScrollBar.LineLeftCommand" Style="{StaticResource ScrollArrowButton}"><Path Data="M 4,0 L 0,4 L 4,8" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/></RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinWidth="24"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource ScrollArrowButton}"><Path Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/></RepeatButton>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="Width" Value="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="{x:Static SystemParameters.HorizontalScrollBarHeight}"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 表格 ================= -->

    <Style x:Key="CheatGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource BgCard}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheatList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- ================= 小圆角矩形徽标（替代胶囊形标签） ================= -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 状态指示：小方块，不用圆形 -->
    <Style x:Key="StatusSquare" TargetType="Border">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
    </Style>

    <!-- 导航项图标：小圆角方块 + 单字，替代 emoji 与圆形装饰 -->
    <Style x:Key="NavBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Background" Value="{DynamicResource BgSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>

    <!-- 翻译服务页：平面设置布局，样式只在该页和对应导航中显式使用。 -->
    <Style x:Key="ServicePageText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ServicePageHint" TargetType="TextBlock" BasedOn="{StaticResource ServicePageText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="ServiceModeOption" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource BgSelected}"/>
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
                            <Setter TargetName="Segment" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ServicePageInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="ServicePagePassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="ServiceProviderPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style x:Key="ServiceSaveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="212"/>
        <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style x:Key="ServiceSidebarItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7"
                            BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Border x:Name="SelectionMarker" Width="4" HorizontalAlignment="Left"
                                    Background="Transparent" Margin="0,7"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BgSelected}"/>
                            <Setter TargetName="SelectionMarker" Property="Background" Value="{DynamicResource AccentText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource PageFocus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
