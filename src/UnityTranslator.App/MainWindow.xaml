                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="翻译服务" Style="{StaticResource ServicePageHint}" Margin="0,14,0,0"/>
                                    <Grid x:Name="ProviderFieldHost" Grid.Column="1">
                                        <StackPanel>
                                            <ComboBox x:Name="FreeProviderBox" Width="{Binding ActualWidth, ElementName=ProviderFieldHost}"
                                                      MaxWidth="490" HorizontalAlignment="Left" Style="{StaticResource ServiceProviderPicker}"
                                                      SelectionChanged="OnFreeProviderSelectionChanged"
                                                      ToolTip="无需账号、API 密钥或付费。仅使用所选服务，不会自动切换其他服务。"
                                                      AutomationProperties.Name="免费翻译服务">
                                                <ComboBoxItem Tag="Bing">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource BingServiceMark}" Width="28" Height="36" Margin="10,0,16,0"/>
                                                        <TextBlock Text="必应 Bing" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                            </ComboBox>
                                            <TextBlock Text="无需账号和密钥" Style="{StaticResource ServicePageHint}" Margin="5,8,0,0"/>
                                            <TextBlock x:Name="FreeProviderStatus" Style="{StaticResource ServicePageHint}"
                                                       Visibility="Collapsed" Margin="5,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Border x:Name="FreeTranslationDelayNotice" Margin="0,18,0,0" Padding="18,12"
                                        Background="{DynamicResource AccentSoft}" CornerRadius="8"
                                        Visibility="{Binding Visibility, ElementName=FreeTranslationPanel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{DynamicResource IconClock}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource ServicePageHint}" Foreground="{DynamicResource AccentText}"
                                                   Text="受必应供应商影响，首次翻译预计需要等待30秒才会生效。&#x0a;后续优先使用本机缓存。"/>
                                    </Grid>
                                </Border>
                                <Grid x:Name="ApiTranslationPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="翻译服务地址" Style="{StaticResource ServicePageHint}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="EndpointBox" Grid.Column="1" Text="https://api.deepseek.com/chat/completions"
                                             TextChanged="OnApiDraftChanged" Style="{StaticResource ServicePageInput}" AutomationProperties.Name="翻译服务地址"/>
                                    <TextBlock Grid.Row="1" Text="模型名称" Style="{StaticResource ServicePageHint}" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Text="deepseek-flash" Margin="0,10,0,0"
