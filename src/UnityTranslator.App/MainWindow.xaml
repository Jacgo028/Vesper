                                    <TextBlock Grid.Row="2" Text="翻译服务密钥" Style="{StaticResource ServicePageHint}" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
