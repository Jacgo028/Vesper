                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,14,0,14"/>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=FreeTranslationPanel}" Value="Visible">
