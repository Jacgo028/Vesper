                                               MaxWidth="340" Margin="20,2,0,0">
                                        <TextBlock x:Name="TranslationServiceSummaryLabel" Text="当前使用：" Style="{StaticResource ServicePageHint}"/>
                                        <TextBlock x:Name="TranslationServiceSummary" FontSize="14" FontWeight="SemiBold"
