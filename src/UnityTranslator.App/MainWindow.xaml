                                    </WrapPanel>
                                </Grid>
                                <Border Width="340" Height="46" HorizontalAlignment="Left" Margin="0,16,0,0"
                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="8">
