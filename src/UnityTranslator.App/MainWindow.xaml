                                                     Checked="OnOpenFreeTranslation" Style="{StaticResource ServiceModeOption}"
                                                     AutomationProperties.Name="免费翻译"/>
                                        <RadioButton x:Name="ApiSettingsButton" Grid.Column="1" Content="API 翻译" GroupName="TranslationMode"
                                                     Tag="{DynamicResource IconTune}" ContentTemplate="{StaticResource ServiceModeContent}"
                                                     Checked="OnSelectApiSettings" Style="{StaticResource ServiceModeOption}"
