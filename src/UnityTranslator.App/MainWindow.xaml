                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{DynamicResource IconClock}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="使用说明" Style="{StaticResource ServicePageHint}"/>
                                    <TextBlock Grid.Column="2" Text="首次翻译可能较慢；首次加载文本较多时可能需要等待，后续优先使用本机缓存。"
                                               Style="{StaticResource ServicePageHint}"/>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{DynamicResource IconShield}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="隐私与说明" Style="{StaticResource ServicePageHint}"/>
                                    <TextBlock x:Name="TranslationPrivacyNotice" Grid.Column="2" Style="{StaticResource ServicePageHint}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,16,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="SaveTranslationSettingsButton" Click="OnSaveTranslationSettings"
                                            Style="{StaticResource ServiceSaveButton}" AutomationProperties.Name="保存并启用">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource IconCheck}" Width="24" Height="24" Margin="0,0,14,0"/>
                                            <TextBlock Text="保存并启用" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0"
                                            Margin="24,10,0,10" Padding="24,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource IconInfo}" Width="22" Height="22" Margin="0,0,12,0"/>
                                            <TextBlock Text="下次启动游戏时生效。" Style="{StaticResource ServicePageHint}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="TranslationSaveStatus" Style="{StaticResource ServicePageHint}"
                                           Visibility="Collapsed" Margin="0,12,0,0"/>
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                                    <DockPanel>
                                        <Image Source="{DynamicResource IconInfo}" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Text, ElementName=TranslationSpeedNotice}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

        <!-- 保留旧状态同步目标，界面只展示当前游戏详情中的单一状态区域。 -->
        <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="VersionLabel"/>
            <TextBlock x:Name="SidebarGameName"/>
            <Border x:Name="SidebarGameDot"/>
            <TextBlock x:Name="SidebarGameStateText"/>
            <Border x:Name="ConnectionDot"/>
            <TextBlock x:Name="ConnectionText"/>
            <TextBlock x:Name="ConnectionDetail"/>
            <TextBlock x:Name="TopPageTitle"/>
            <TextBlock x:Name="TopGameText"/>
            <TextBlock x:Name="TopNextStep"/>
        </StackPanel>

        <!-- 确认层覆盖整个窗口工作区，保留键盘和按钮交互。 -->
        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Background="{DynamicResource OverlayScrim}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="420" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Text="确认操作" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="ConfirmMessage" Style="{StaticResource Hint}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfirmDetail" Style="{StaticResource TechnicalText}" Margin="0,9,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="ConfirmCancelButton" Content="取消" Click="OnConfirmCancel"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinWidth="86"/>
                        <Button x:Name="ConfirmOkButton" Content="确认" Click="OnConfirmAccept"
                                Style="{DynamicResource DangerButton}" MinWidth="86"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

