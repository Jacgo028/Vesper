                                </Border>
                                <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,16,0,14"/>
                                <TextBlock Text="服务配置" FontSize="19" FontWeight="SemiBold" LineHeight="26"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="选择翻译服务并保存后，下次启动游戏时生效。"
